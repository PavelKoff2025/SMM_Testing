# ===== Окружение =====
# dev — локальная разработка/демо (допускаются рабочие дефолты секретов).
# prod — боевое: старт упадёт, если TEACHER_PASSWORD/SECRET_KEY не заданы или равны дефолтам.
APP_ENV=dev

# ===== Доступ преподавателя к кабинету =====
# В prod — обязательно задать свой пароль (не 'changeme').
TEACHER_PASSWORD=changeme

# ===== Сессия (подписанная кука) =====
# Случайная длинная строка. В prod — обязательна и не должна быть дефолтной.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# ===== Генерация тестов из PDF (OpenAI) =====
OPENAI_API_KEY=sk-вставьте-ключ-сюда
OPENAI_MODEL=gpt-4o-mini
# AI_MOCK=1 — генерация возвращает демо-тест без вызова OpenAI (для разработки без ключа).
# AI_MOCK=0 — реальный вызов GPT-4o-mini (нужен заполненный OPENAI_API_KEY).
AI_MOCK=1
AI_MAX_TEXT_CHARS=32000

# ===== Загрузка файлов (PDF/JSON) =====
# Лимит размера в байтах (~26 МБ). Защита от OOM/DoS.
MAX_UPLOAD_BYTES=27262976

# ===== Отправка результатов студентам (Яндекс SMTP) =====
# Используется пароль приложения Яндекс (не основной пароль).
# SMTP_ENABLED=0 — отправка выключена (результат виден в кабинете студента).
# SMTP_ENABLED=1 — отправлять письмо после прохождения теста.
SMTP_ENABLED=0
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=pkarikov@yandex.ru
SMTP_PASSWORD=
SMTP_FROM_NAME=Павел Кофф — преподаватель
SMTP_TIMEOUT=20

# ===== Расписание тестов (Этап 7, APScheduler) =====
# Часовой пояс, в котором преподаватель задаёт время открытия (форма datetime-local).
SCHEDULE_TZ=Europe/Moscow
# Как часто (сек) планировщик проверяет наступление времени scheduled-тестов.
SCHEDULER_INTERVAL_SECONDS=30