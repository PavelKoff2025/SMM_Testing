# ===== Доступ преподавателя к кабинету =====
TEACHER_PASSWORD=changeme

# ===== Генерация тестов из PDF (OpenAI) =====
OPENAI_API_KEY=sk-вставьте-ключ-сюда
OPENAI_MODEL=gpt-4o-mini
# AI_MOCK=1 — генерация возвращает демо-тест без вызова OpenAI (для разработки без ключа).
# AI_MOCK=0 — реальный вызов GPT-4o-mini (нужен заполненный OPENAI_API_KEY).
AI_MOCK=1
AI_MAX_TEXT_CHARS=32000

# ===== Отправка результатов студентам (Яндекс SMTP) =====
# Используется пароль приложения Яндекс (не основной пароль).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=pkarikov@yandex.ru
SMTP_PASSWORD=
SMTP_FROM_NAME=Павел Кофф — преподаватель